+class _LocalEmbeddingClient:
+    """OpenAI-compatible embeddings client for a locally hosted /v1/embeddings.
+
+    Added for reproducibility only. Upstream always talks to Azure, but the
+    reproduction runs against a local OpenAI-compatible endpoint that does not
+    serve an embedding model, so the Retrieval baseline could not run.
+    Set ACON_LOCAL_EMBEDDING_URL (e.g. http://127.0.0.1:9200/v1) to redirect
+    embeddings to experiments/repro/embedding_server.py. Unset = original
+    Azure behaviour, so this is fully backwards compatible.
+    """
+
+    def __init__(self, base_url: str, model_name: str):
+        self._url = base_url.rstrip("/") + "/embeddings"
+        self._model = model_name
+        self._key = os.environ.get("ACON_LOCAL_EMBEDDING_KEY", "not-needed")
+
+    def get_response(self, msg: dict) -> dict:
+        body = {"model": self._model, "input": msg.get("input", [])}
+        r = requests.post(
+            self._url,
+            json=body,
+            headers={"Authorization": f"Bearer {self._key}"},
+            timeout=300,
+        )
+        r.raise_for_status()
+        return r.json()
+
