__pycache__/
*.pyc

# Generated by make_configs.py from methods.yml -- reproducible, so not tracked.
configs/

# Token-counting cache that analysis_tools.analyze_experiment_tokens_v2 writes into
# the current directory. Binary, machine-local, and regenerated on demand.
analysis/

# Run artefacts written by the vendored harness. run_all.py writes ./outputs and
# AppWorld writes ./experiments (dbs and evaluation reports) relative to its entry
# point; both are per-run and regenerated, so neither is tracked.
experiments/appworld/outputs/
experiments/appworld/experiments/
experiments/appworld/shards/
experiments/appworld/error.log

# A symlink to the AppWorld install's data directory, created by run_suite.sh.
experiments/appworld/data

.venv/
.pytest_cache/
